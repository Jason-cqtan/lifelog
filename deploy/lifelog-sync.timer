[Unit]
Description=Run the lifelog sync every day at 08:00

[Timer]
# daily at 08:00 (server time, Asia/Shanghai). Spotify only exposes the last
# 50 plays, so anything beyond that between runs is lost.
OnCalendar=*-*-* 08:00:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
