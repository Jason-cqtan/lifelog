[Unit]
Description=Run the lifelog sync every day at 08:00, 13:00 and 22:00

[Timer]
# 08:00, 13:00 and 22:00 (server time, Asia/Shanghai). Spotify only exposes the
# last 50 plays, so anything beyond that between runs is lost.
OnCalendar=*-*-* 08,13,22:00:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
