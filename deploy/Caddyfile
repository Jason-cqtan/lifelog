# Installed to /etc/caddy/Caddyfile by install.sh ({{DOMAIN}} / {{EMAIL}} filled in).
# Caddy gets the certificate from Let's Encrypt on first request and renews it
# by itself (about 30 days before expiry); nothing else to schedule.
{
	email {{EMAIL}}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{{DOMAIN}} {
	root * /opt/lifelog/www
	# max-strength .br/.zst/.gz written by compress.sh; anything else is compressed on the fly
	file_server {
		precompressed br zstd gzip
		hide .next
	}
	encode zstd gzip

	# rewritten every hour by the sync
	header /data.json Cache-Control "no-cache"
	# Vite file names carry a content hash
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.{{DOMAIN}} {
	redir https://{{DOMAIN}}{uri} permanent
}
