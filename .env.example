# Copy to .env for local runs (never commit .env).
#
# With DATABASE_URL set, data and settings live in PostgreSQL: everything below
# the first block is edited in the admin page (/admin/, `lifelog serve`) and
# only needs to be here once, for `lifelog db import -env .env`. Without it,
# lifelog uses data/*.json and reads the settings from here (and GitHub Actions
# from repository Secrets).

DATABASE_URL=                # e.g. postgres:///lifelog (local socket)
LIFELOG_ADMIN_PASSWORD=      # admin page login until changed there

LIFELOG_TZ=Asia/Shanghai
LIFELOG_SYNC_HOURS=8,13,22   # lifelog serve syncs at these hours (LIFELOG_TZ)
LIFELOG_GIT_BACKUP=true      # lifelog serve -repo: push data/*.json to GitHub after each sync

# Strava — https://www.strava.com/settings/api, callback domain 127.0.0.1
LIFELOG_PUSH_TOKEN=          # Apple Watch: what Health Auto Export sends to /api/push/applehealth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=        # lifelog auth strava

# Garmin — GARMIN_CN=true for garmin.cn accounts
GARMIN_TOKEN=                # lifelog auth garmin
GARMIN_CN=

# COROS — COROS_CN=true for the China server
COROS_ACCOUNT=
COROS_PASSWORD=
COROS_CN=

# Duolingo — the jwt_token cookie from duolingo.com
DUOLINGO_JWT=

# Spotify — https://developer.spotify.com/dashboard, redirect URI http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=       # lifelog auth spotify

# GitHub — a personal access token with read:user
GH_USERNAME=
GH_TOKEN=

# Mapbox — public token (pk.*) for the map tab; restrict it to your site's URL
# at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
VITE_MAP_GCJ02=              # true if routes in China sit beside the roads

# Map lock — routes are kept encrypted with this answer, both in the repo
# (data/routes.json) and on the site (routes.enc); the site asks the question
# before showing the map. Keep the answer out of the repo: .env, the VPS's
# /opt/lifelog/.env and an Actions secret. Without it no routes are exported,
# and a sync refuses to store new ones. To change it: set the new answer, run
# `lifelog seal -old OLD_ANSWER`, then update the VPS and the Actions secret.
LIFELOG_MAP_QUESTION=站长姓氏？
LIFELOG_MAP_ANSWER=
