# Copy to .env for local runs (never commit .env). In GitHub, add these as
# repository Secrets (Settings -> Secrets and variables -> Actions).

LIFELOG_TZ=Asia/Shanghai

# Strava — https://www.strava.com/settings/api, callback domain 127.0.0.1
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=        # lifelog auth strava

# Garmin — GARMIN_CN=true for garmin.cn accounts
GARMIN_TOKEN=                # lifelog auth garmin
GARMIN_CN=

# COROS — COROS_CN=true for the China server
COROS_ACCOUNT=
COROS_PASSWORD=
COROS_CN=

# Duolingo — the jwt_token cookie from duolingo.com
DUOLINGO_JWT=

# Spotify — https://developer.spotify.com/dashboard, redirect URI http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=       # lifelog auth spotify

# GitHub — a personal access token with read:user
GH_USERNAME=
GH_TOKEN=

# Mapbox — public token (pk.*) for the map tab; restrict it to your site's URL
# at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
VITE_MAP_GCJ02=              # true if routes in China sit beside the roads
